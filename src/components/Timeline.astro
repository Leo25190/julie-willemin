---
import { Icon } from 'astro-icon/components';

export interface Props {
  activities: Array<{
    id: string;
    name: string;
    type: string[];
    dates: { start: string; end?: string };
    location?: string;
    summary: string;
    slug: string;
  }>;
}

const { activities } = Astro.props;

// Function to format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('fr-FR', { 
    month: 'long',
    year: 'numeric'
  });
}

// Function to format date range
function formatDateRange(start: string, end?: string): string {
  if (end && end !== start) {
    return `${formatDate(start)} - ${formatDate(end)}`;
  }
  return formatDate(start);
}

// Function to get icon for activity type
function getTypeIcon(types: string[]): string {
  if (types.some(t => t.includes('Projet'))) {
    return 'mdi:lightbulb-on';
  } else if (types.some(t => t.includes('Bénévolat'))) {
    return 'mdi:heart';
  } else if (types.some(t => t.includes('Expérience'))) {
    return 'mdi:briefcase';
  }
  return 'mdi:circle';
}

// Function to get type badge color
function getTypeBadgeColor(types: string[]): string {
  if (types.some(t => t.includes('Projet'))) {
    return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
  } else if (types.some(t => t.includes('Bénévolat'))) {
    return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  } else if (types.some(t => t.includes('Expérience'))) {
    return 'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200';
  }
  return 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200';
}

// Function to get type color for timeline elements
function getTypeColor(types: string[]): string {
  if (types.some(t => t.includes('Projet'))) {
    return 'from-blue-500 to-purple-600';
  } else if (types.some(t => t.includes('Bénévolat'))) {
    return 'from-green-500 to-emerald-600';
  } else if (types.some(t => t.includes('Expérience'))) {
    return 'from-orange-500 to-red-600';
  }
  return 'from-gray-500 to-gray-600';
}

// Function to format summary with line breaks
function formatSummary(summary: string): string {
  return summary.replace(/\n/g, '<br>');
}
---

<div class="relative max-w-6xl mx-auto px-4">
  <!-- Timeline Line - Hidden on small devices -->
  <div class="absolute left-4 md:left-8 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-400 via-purple-500 to-pink-500 opacity-80 rounded-full hidden md:block"></div>
  
  <!-- Timeline Items -->
  <div class="space-y-8 md:space-y-12">
    {activities.map((activity, index) => (
      <div class="relative flex items-start">
        <!-- Timeline Dot - Hidden on small devices -->
        <div class={`absolute left-2 md:left-[6px] w-6 h-6 rounded-full bg-gradient-to-r ${getTypeColor(activity.type)} border-4 border-white dark:border-gray-900 shadow-lg z-10 hidden md:block`}>
        </div>
        
        <!-- Activity Card -->
        <div class="ml-0 md:ml-16 flex-1">
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-6">
            <!-- Date and Type -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-2">
              <span class="text-sm font-medium text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-4 py-2 rounded-full">
                <Icon name="mdi:calendar" class="w-4 h-4 inline mr-2" />
                {formatDateRange(activity.dates.start, activity.dates.end)}
              </span>
              {activity.type.length > 0 && (
                <span class={`text-xs font-semibold px-3 py-1.5 rounded-full ${getTypeBadgeColor(activity.type)} self-start sm:self-auto flex items-center`}>
                  <Icon name={getTypeIcon(activity.type)} class="w-4 h-4 mr-1" />
                  {activity.type[0]}
                </span>
              )}
            </div>
            
            <!-- Activity Title -->
            <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-3">
              {activity.name}
            </h3>
            
            <!-- Location -->
            {activity.location && (
              <div class="flex items-center mb-4 text-gray-600 dark:text-gray-300">
                <Icon name="mdi:map-marker" class="w-5 h-5 mr-3 text-gray-400" />
                <span class="text-sm font-medium">{activity.location}</span>
              </div>
            )}
            
            <!-- Summary with rich text -->
            {activity.summary && (
              <div class="text-gray-700 dark:text-gray-300 leading-relaxed text-xs md:text-base" set:html={formatSummary(activity.summary)}>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>